# Copie para infra/.env (o bootstrap faz isso automaticamente) e ajuste.

# Hostname/porta pelos quais o GitLab é acessado (na VM, use o IP/DNS público)
GITLAB_HOST=localhost
GITLAB_PORT=8929
GITLAB_ROOT_PASSWORD=ChangeMe-Str0ng-Pass2024
